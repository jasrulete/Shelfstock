# Copy to .env.local and fill in. The API runs inside this same Next.js app,
# so there is deliberately NO NEXT_PUBLIC_API_URL: the browser calls /api
# relatively. Baking an absolute backend host into the bundle at build time is
# what once left the storefront showing "Failed to fetch" after the old backend
# went away.

# --- required ---

# Postgres. With `docker compose up -d db`, the local database is on port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/shelfstock

# Signs JWTs. 32+ characters. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-please

# --- optional ---

# Free currency conversion API - no key required.
# https://www.frankfurter.app/docs/
NEXT_PUBLIC_EXCHANGE_RATE_API=https://api.frankfurter.app/latest?from=USD

# Authorizes the daily win-back cron endpoint. Unset means the route refuses to
# run (503) rather than sitting open to anyone who finds it.
# CRON_SECRET=

# Transactional email (Resend). Unset means every send is a logged no-op, which
# is the right default for local development.
# RESEND_API_KEY=
# MAIL_FROM=ShelfStock <onboarding@resend.dev>
