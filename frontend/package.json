{
  "name": "shelfstock",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:status": "node-pg-migrate --dry-run up",
    "db:setup": "node-pg-migrate up",
    "create-admin": "node scripts/create-admin.js",
    "seed-demo-users": "node scripts/seed-demo-users.js"
  },
  "_comment_overrides": "Two transitive pins that next controls but we carry the risk for. postcss: next pins it exactly and that pin has landed inside a vulnerable range (GHSA-6g55-p6wh-862q / GHSA-r28c-9q8g-f849, sourceMappingURL path traversal). sharp: next declares ^0.34.3, which cannot reach the patched 0.35.x on its own because a caret does not cross a 0.x minor; <0.35.0 carries the libvips CVEs (CVE-2026-33327/33328/35590/35591). npm's own advice was to downgrade to next@14, which would reintroduce the far larger set of Next advisories. Drop each override once next depends on a patched version itself.",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
